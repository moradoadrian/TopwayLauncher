<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        PERMISOS. Ninguno se concede al instalar salvo BLUETOOTH en Android ≤ 11, que es
        "normal". Todos se usan solo si el usuario activa la función en Ajustes del launcher.

        - BLUETOOTH (Android ≤ 11) / BLUETOOTH_CONNECT (Android 12+): conectar con un adaptador
          OBD-II ELM327 YA EMPAREJADO en Android. No se busca ni se empareja nada, así que no se
          piden BLUETOOTH_SCAN, BLUETOOTH_ADMIN ni ubicación para Bluetooth.
        - ACCESS_FINE_LOCATION: velocidad del GPS (opcional). Se pide en tiempo de ejecución con
          una explicación previa. La posición no se guarda ni se envía.
        - ACCESS_COARSE_LOCATION: Android 12+ obliga a pedirlo junto con el anterior. Por sí
          solo no basta para la velocidad; la app lo explica si el usuario elige "aproximada".

        No hay permiso de Internet: la app no envía datos a ningún servidor.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Opcionales: la app se instala y funciona en equipos sin Bluetooth o sin GPS. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!--
        Para listar aplicaciones en Android 11+ (API 30+) basta con declarar qué intents se
        consultan; NO se usa QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Teléfono predeterminado, para los accesos rápidos. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- Google Maps: para comprobar si puede abrir su URL pública antes de lanzarla. -->
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TopwayLauncher"
        tools:targetApi="36">

        <!--
            Prototipo: se abre como una app normal desde el cajón de aplicaciones.
            singleTask + stateNotNeeded es lo habitual en launchers y no afecta al uso normal.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            MODO LAUNCHER (PREPARADO, DESACTIVADO).
            Con android:enabled="false" el sistema ignora este alias, así que la app NO se
            ofrece como pantalla de inicio. Para activarlo en una fase posterior, cambiar a
            "true", reinstalar y elegirla manualmente en Ajustes (ver docs/MODO_LAUNCHER.md).
        -->
        <activity-alias
            android:name=".HomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!--
            Lo que suena (OPCIONAL). No es un permiso que se pida al instalar: el usuario decide
            si concede el "acceso a notificaciones" desde Ajustes, y puede retirarlo. Con él,
            la tarjeta de música lee las sesiones multimedia públicas de otras apps. El servicio
            está vacío: no lee ni guarda notificaciones. BIND_NOTIFICATION_LISTENER_SERVICE
            garantiza que solo el sistema pueda conectarse a él.
        -->
        <service
            android:name=".data.MediaListenerService"
            android:exported="true"
            android:label="@string/media_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
